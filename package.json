{
  "name": "magic-graphs",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter @multiplayer/server dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter @multiplayer/server dev",
    "build": "pnpm --filter client build",
    "preview": "pnpm --filter client preview",
    "storybook": "pnpm --filter @canvas/primitives storybook",
    "test": "vitest",
    "build:types": "vue-tsc -b tsconfig.json",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "clean:nuke": "pnpm clean && rm -rf node_modules packages/*/node_modules && pnpm install && pnpm build:types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.2.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.7"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
