{
  "name": "@graph/plugins-shared",
  "version": "1.0.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./plugins": {
      "types": "./dist/types/plugins/index.d.ts",
      "default": "./src/plugins/index.ts"
    },
    "./lifecycle": {
      "types": "./dist/types/lifecycle/index.d.ts",
      "default": "./src/lifecycle/index.ts"
    },
    "./drag": {
      "types": "./dist/types/drag/index.d.ts",
      "default": "./src/drag/index.ts"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build:types": "vue-tsc -b tsconfig.json"
  },
  "dependencies": {
    "@core/events": "workspace:*",
    "@graph/primitives": "workspace:*",
    "@graph/core": "workspace:*",
    "@core/utils": "workspace:*",
    "@graph/render-functions": "workspace:*",
    "@core/themes": "workspace:*",
    "@graph/computed-tokens": "workspace:*"
  },
  "devDependencies": {
    "ts-essentials": "^10.2.0"
  }
}
